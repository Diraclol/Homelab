(headers) {
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin"
		X-Robots-Tag "noindex, nofollow, nosnippet, noarchive"
	}
}

fx504.duckdns.org, *.fx504.duckdns.org {
	import headers
	tls {
		dns duckdns {env.DUCKDNS_API_TOKEN}
		propagation_delay 2m
	}

	@photos host photos.fx504.duckdns.org
	handle @photos {
		reverse_proxy 127.0.0.1:2283
	}

	@dockge host dockge.fx504.duckdns.org
	handle @dockge {
		reverse_proxy 127.0.0.1:5001
	}

	@home host home.fx504.duckdns.org
	handle @home {
		reverse_proxy 127.0.0.1:3001
	}

	@glances host glances.fx504.duckdns.org
	handle @glances {
		reverse_proxy 127.0.0.1:61208
	}

	@cockpit host cockpit.fx504.duckdns.org
	handle @cockpit {
		reverse_proxy https://127.0.0.1:9090 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@stream host stream.fx504.duckdns.org
	handle @stream {
		reverse_proxy https://127.0.0.1:47990 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@tv host tv.fx504.duckdns.org
	handle @tv {
		reverse_proxy 127.0.0.1:8080
	}

	@llm host llm.fx504.duckdns.org
	handle @llm {
		reverse_proxy 127.0.0.1:8082
	}

	@filebrowser host filebrowser.fx504.duckdns.org
	handle @filebrowser {
		reverse_proxy 127.0.0.1:8085
	}

	handle {
		redir https://home.fx504.duckdns.org{uri}
	}
}
