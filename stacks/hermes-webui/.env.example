# Hermes WebUI — Docker Compose configuration template
#
# Copy this file to `.env` next to your docker-compose.yml.
# All variables are optional — Docker Compose substitutes defaults if unset.
#
#   cp .env.example .env
#   # edit values you care about, then:
#   docker compose up -d

# ──────────────────────────────────────────────────────────────────────────
# UID / GID — host user mapping
# ──────────────────────────────────────────────────────────────────────────
UID=1000
GID=1000

# ──────────────────────────────────────────────────────────────────────────
# Hermes home directory — where config, sessions, skills, and state live
# ──────────────────────────────────────────────────────────────────────────
# Default: /var/mnt/storage/hermes-data (persistent across reinstalls)
# Override if you want it elsewhere:
# HERMES_HOME=/home/jguy/.hermes

# ──────────────────────────────────────────────────────────────────────────
# Workspace directory — shown in the WebUI file browser
# ──────────────────────────────────────────────────────────────────────────
HERMES_WORKSPACE=/home/jguy/Workspace

# ──────────────────────────────────────────────────────────────────────────
# Password — protect the WebUI
# ──────────────────────────────────────────────────────────────────────────
# Optional: set a password for basic auth on the web interface
# HERMES_WEBUI_PASSWORD=your-strong-password-here

# ──────────────────────────────────────────────────────────────────────────
# Gateway mode — connect to freellmapi
# ──────────────────────────────────────────────────────────────────────────
# Set to 'gateway' to use the freellmapi gateway (recommended)
HERMES_WEBUI_CHAT_BACKEND=gateway

# freellmapi gateway URL (should match your freellmapi stack)
HERMES_WEBUI_GATEWAY_BASE_URL=http://127.0.0.1:8082

# freellmapi API key (required for gateway mode)
# Get this from your freellmapi .env or the web UI
HERMES_WEBUI_GATEWAY_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Optional: Custom provider (alternative to gateway mode)
# ──────────────────────────────────────────────────────────────────────────
# Uncomment these and comment out the gateway vars above to use custom provider mode
# HERMES_WEBUI_CHAT_BACKEND=custom
# HERMES_WEBUI_CUSTOM_PROVIDER_NAME=freellmapi
# HERMES_WEBUI_CUSTOM_PROVIDER_BASE_URL=http://127.0.0.1:8082/v1
# HERMES_WEBUI_CUSTOM_PROVIDER_API_KEY=your-freellmapi-key-here
